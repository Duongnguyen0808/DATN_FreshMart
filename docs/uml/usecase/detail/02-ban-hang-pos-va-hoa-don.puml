@startuml
title Sơ đồ Use Case Chi tiết: Bán hàng POS, Hóa đơn và Thanh toán

left to right direction
skinparam linetype polyline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam usecaseFontSize 11
skinparam actorFontSize 11
skinparam usecaseBorderColor #222222
skinparam usecaseBackgroundColor #F8FCFB
skinparam rectangleBorderColor #444444
skinparam ArrowColor #333333
skinparam nodesep 26
skinparam ranksep 65

actor "Nhân viên\n(EMPLOYEE)" as Staff
actor "Quản lý chi nhánh\n(BRANCH_MANAGER)" as Manager

rectangle "Phân hệ Bán hàng POS & Hóa đơn" {
  usecase "Mở và chốt\nca làm việc" as UC_POS_01
  usecase "Tạo hóa đơn\nbán hàng POS" as UC_POS_02
  usecase "Xuất kho tự động\ntheo lô FEFO" as UC_POS_03
  usecase "Áp dụng mã xả\ncận hạn FEFO" as UC_POS_04
  usecase "Thanh toán QR\nqua PayOS" as UC_POS_05
  usecase "Ghi nhận công nợ\nphải thu" as UC_POS_06
  usecase "Tra cứu hóa đơn\nvà thanh toán" as UC_POS_09
  usecase "Hủy hóa đơn\nvà hoàn tồn lô" as UC_POS_07
  usecase "Xử lý trả hàng\nkhách mua" as UC_POS_08
}

actor "Cổng PayOS" as PayOS

Staff -- UC_POS_01
Staff -- UC_POS_02
Staff -- UC_POS_09

Manager -- UC_POS_02
Manager -- UC_POS_09
Manager -- UC_POS_07
Manager -- UC_POS_08

UC_POS_02 ..> UC_POS_03 : <<include>>
UC_POS_04 ..> UC_POS_02 : <<extend>>
UC_POS_05 ..> UC_POS_02 : <<extend>>
UC_POS_06 ..> UC_POS_02 : <<extend>>

UC_POS_05 -- PayOS
@enduml
