{
  "expo": {
    "name": "FreshMart Ops",
    "slug": "freshmart-mobile",
    "scheme": "freshmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0d7a73"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.freshmart.retail.ops",
      "infoPlist": {
        "NSCameraUsageDescription": "FreshMart sử dụng camera iPhone để quét mã vạch sản phẩm và mã QR lô hàng tại kho."
      }
    },
    "android": {
      "package": "com.freshmart.retail.ops",
      "adaptiveIcon": {
        "backgroundColor": "#0d7a73",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "FreshMart sử dụng camera iPhone để quét mã vạch sản phẩm và mã QR lô hàng tại kho."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b15b79f5-2961-4446-a351-40f2884c7d65"
      }
    },
    "owner": "duongnguyen88",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b15b79f5-2961-4446-a351-40f2884c7d65"
    }
  }
}
