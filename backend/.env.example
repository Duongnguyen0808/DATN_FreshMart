NODE_ENV=development
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://smart_store:CHANGE_ME@localhost:5432/smart_store?schema=public
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
LOG_LEVEL=info
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Shared device-ingestion token; generate a random secret with at least 32 characters.
IOT_INGEST_TOKEN=
SEED_OWNER_EMAIL=owner@smartstore.local
SEED_OWNER_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SEED_CASHIER_EMAIL=cashier@smartstore.local
SEED_CASHIER_PASSWORD=REPLACE_WITH_A_SEPARATE_STRONG_PASSWORD

# payOS: keys stay on the backend only. Leave unset until the channel is ready.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/thanh-toan/payos
PAYOS_CANCEL_URL=http://localhost:3000/thanh-toan/payos
