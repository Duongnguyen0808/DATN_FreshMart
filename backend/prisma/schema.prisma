  updatedAt              DateTime  @updatedAt
  sourceWarehouse        Warehouse @relation("TransferSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destinationWarehouse   Warehouse @relation("TransferDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
