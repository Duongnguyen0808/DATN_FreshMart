generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id           String   @id @default(uuid()) @db.NVarChar(191)
  email        String @db.NVarChar(191)   @unique
  name         String @db.NVarChar(191)
  passwordHash String @db.NVarChar(Max)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roles        UserRole[]
  stores       UserStore[]
  sessions     Session[]
  priceChanges PriceHistory[]
  cashierShifts WorkShift[] @relation("ShiftCashier")
  approvedShifts WorkShift[] @relation("ShiftApprover")
  salesInvoices Invoice[] @relation("InvoiceCashier")
  cancelledInvoices Invoice[] @relation("InvoiceCanceller")
  inventoryTransactions InventoryTransaction[]
  payosCheckouts PayosCheckout[]
  createdIotTagMappings IotTagMapping[]
  processedIotEvents IotEvent[] @relation("IotEventProcessor")
  warehouseAccessCards WarehouseAccessCard[]
  warehouseAccessEvents WarehouseAccessEvent[]
  createdStocktakes Stocktake[] @relation("StocktakeCreator")
  approvedStocktakes Stocktake[] @relation("StocktakeApprover")
  createdTransfers StockTransfer[] @relation("TransferCreator")
  approvedTransfers StockTransfer[] @relation("TransferApprover")
  dispatchedTransfers StockTransfer[] @relation("TransferDispatcher")
  receivedTransfers StockTransfer[] @relation("TransferReceiver")
  cancelledTransfers StockTransfer[] @relation("TransferCanceller")
  resolvedTransferDiscrepancies StockTransfer[] @relation("TransferDiscrepancyResolver")
  createdPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestCreator")
  approvedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestApprover")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreator")
  receivedGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptReceiver")
  payablePayments PayablePayment[] @relation("PayablePaymentActor")
  processedSalesReturns SalesReturn[] @relation("SalesReturnProcessor")
  processedSupplierReturns SupplierReturn[] @relation("SupplierReturnProcessor")
  receivablePayments ReceivablePayment[] @relation("ReceivablePaymentActor")
  generatedRecommendations InventoryRecommendation[] @relation("RecommendationGenerator")
  decidedRecommendations InventoryRecommendation[] @relation("RecommendationDecider")
  @@map("users")
}

model Role {
  id          String @id @default(uuid()) @db.NVarChar(191)
  code        String @db.NVarChar(191) @unique
  name        String @db.NVarChar(191)
  system      Boolean @default(false)
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  code  String @db.NVarChar(191) @id
  name  String @db.NVarChar(191)
  roles RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId String @db.NVarChar(191)
  roleId String @db.NVarChar(191)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId String @db.NVarChar(191)
  permissionCode String @db.NVarChar(191)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

// Minimal organization records needed for phase 1 branch assignments.
model Store {
  id String @id @default(uuid()) @db.NVarChar(191)
  code String @db.NVarChar(191) @unique
  name String @db.NVarChar(191)
  address String @db.NVarChar(Max) @default("")
  region String @db.NVarChar(191) @default("MIEN_BAC")
  phone String? @db.NVarChar(191)
  managerName String? @db.NVarChar(191)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users UserStore[]
  warehouses Warehouse[]
  shifts WorkShift[]
  invoices Invoice[]
  purchaseRequests PurchaseRequest[]
  receivables Receivable[]
  forecastRuns ForecastRun[]
  inventoryRecommendations InventoryRecommendation[]
  @@map("stores")
}

model Warehouse {
  id String @id @default(uuid()) @db.NVarChar(191)
  code String @db.NVarChar(191) @unique
  name String @db.NVarChar(191)
  address String @db.NVarChar(Max) @default("")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  storeId String @db.NVarChar(191)
  store Store @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payosCheckouts PayosCheckout[]
  inventories Inventory[]
  inventoryTransactions InventoryTransaction[]
  invoices Invoice[]
  stocktakes Stocktake[]
  sourceTransfers StockTransfer[] @relation("TransferSourceWarehouse")
  destinationTransfers StockTransfer[] @relation("TransferDestinationWarehouse")
  sourceRecommendations InventoryRecommendation[] @relation("RecommendationSource")
  destinationRecommendations InventoryRecommendation[] @relation("RecommendationDestination")
  purchaseOrders PurchaseOrder[]
  salesReturns SalesReturn[]
  supplierReturns SupplierReturn[]
  iotEvents IotEvent[]
  iotTagMappings IotTagMapping[]
  accessDevices WarehouseAccessDevice[]
  accessDoors WarehouseAccessDoor[]
  accessCards WarehouseAccessCard[]
  accessEvents WarehouseAccessEvent[]
  securityAlerts WarehouseSecurityAlert[]
  @@index([storeId])
  @@map("warehouses")
}

model UserStore {
  userId String @db.NVarChar(191)
  storeId String @db.NVarChar(191)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  store Store @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([userId, storeId])
  @@map("user_stores")
}

model Session {
  id String @id @default(uuid()) @db.NVarChar(191)
  userId String @db.NVarChar(191)
  refreshHash String @db.NVarChar(Max)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id String @id @default(uuid()) @db.NVarChar(191)
  actorId String? @db.NVarChar(191)
  action String @db.NVarChar(191)
  targetId String? @db.NVarChar(191)
  metadata String? @db.NVarChar(Max)
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model IotEvent {
  id             String    @id @default(uuid()) @db.NVarChar(191)
  eventId        String @db.NVarChar(191)
  deviceId       String @db.NVarChar(191)
  inboundParcelId String? @db.NVarChar(191)
  automationStatus String? @db.NVarChar(191)
  automationMessage String? @db.NVarChar(Max)
  goodsReceiptId String? @db.NVarChar(191)
  eventType      String @db.NVarChar(191)
  tagId          String @db.NVarChar(191)
  warehouseId    String    @db.NVarChar(191)
  timestamp      DateTime
  payload        String @db.NVarChar(Max)
  tagMappingId   String?   @db.NVarChar(191)
  mappedSkuId    String?   @db.NVarChar(191)
  palletCode     String? @db.NVarChar(191)
  processed      Boolean   @default(false)
  processedAt    DateTime?
  processedById  String?   @db.NVarChar(191)
  confirmedReferenceType String? @db.NVarChar(191)
  confirmedReferenceId String? @db.NVarChar(191)
  source         String @db.NVarChar(191)    @default("DEVICE")
  receivedAt     DateTime  @default(now())
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tagMapping     IotTagMapping? @relation(fields: [tagMappingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mappedSku      Sku?      @relation("IotEventMappedSku", fields: [mappedSkuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  processedBy    User?     @relation("IotEventProcessor", fields: [processedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([deviceId, eventId])
  @@index([warehouseId, timestamp])
  @@index([processed, timestamp])
  @@index([tagId, timestamp])
  @@map("iot_events")
}

model IotTagMapping {
  id          String    @id @default(uuid()) @db.NVarChar(191)
  tagId       String @db.NVarChar(191)    @unique
  skuId       String    @db.NVarChar(191)
  warehouseId String    @db.NVarChar(191)
  palletCode  String? @db.NVarChar(191)
  source      String @db.NVarChar(191)    @default("HARDWARE")
  active      Boolean   @default(true)
  createdById String    @db.NVarChar(191)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sku         Sku       @relation(fields: [skuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events      IotEvent[]

  @@index([warehouseId, active])
  @@index([skuId])
  @@map("iot_tag_mappings")
}

// Physical warehouse access is independent of parcel receiving and inventory.
model WarehouseAccessDevice {
  id String @id @default(uuid()) @db.NVarChar(191)
  code String @db.NVarChar(191) @unique
  name String @db.NVarChar(191)
  warehouseId String @db.NVarChar(191)
  active Boolean @default(true)
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doors WarehouseAccessDoor[]
  events WarehouseAccessEvent[]
  @@index([warehouseId, active])
  @@map("warehouse_access_devices")
}

model WarehouseAccessDoor {
  id String @id @default(uuid()) @db.NVarChar(191)
  code String @db.NVarChar(191) @unique
  name String @db.NVarChar(191)
  warehouseId String @db.NVarChar(191)
  deviceId String @db.NVarChar(191)
  state String @db.NVarChar(191) @default("CLOSED")
  lastStateChangedAt DateTime?
  openSince DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  device WarehouseAccessDevice @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events WarehouseAccessEvent[]
  alerts WarehouseSecurityAlert[]
  @@index([warehouseId, state])
  @@map("warehouse_access_doors")
}

model WarehouseAccessCard {
  id String @id @default(uuid()) @db.NVarChar(191)
  uid String @db.NVarChar(191) @unique
  employeeId String @db.NVarChar(191)
  warehouseId String @db.NVarChar(191)
  status String @db.NVarChar(191) @default("ACTIVE")
  assignedAt DateTime @default(now())
  revokedAt DateTime?
  employee User @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([warehouseId, status])
  @@map("warehouse_access_cards")
}

model WarehouseAccessEvent {
  id String @id @default(uuid()) @db.NVarChar(191)
  eventId String @db.NVarChar(191)
  deviceId String @db.NVarChar(191)
  warehouseId String @db.NVarChar(191)
  doorId String? @db.NVarChar(191)
  employeeId String? @db.NVarChar(191)
  eventType String @db.NVarChar(191)
  source String @db.NVarChar(191)
  occurredAt DateTime @default(now())
  reportedAt DateTime?
  consumedAt DateTime?
  payload String @db.NVarChar(Max)
  createdAt DateTime @default(now())
  device WarehouseAccessDevice @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  door WarehouseAccessDoor? @relation(fields: [doorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee User? @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([deviceId, eventId])
  @@index([warehouseId, occurredAt])
  @@index([deviceId, eventType, occurredAt])
  @@map("warehouse_access_events")
}

model WarehouseSecurityAlert {
  id String @id @default(uuid()) @db.NVarChar(191)
  warehouseId String @db.NVarChar(191)
  doorId String @db.NVarChar(191)
  employeeId String? @db.NVarChar(191)
  type String @db.NVarChar(191)
  severity String @db.NVarChar(191) @default("WARNING")
  message String @db.NVarChar(Max)
  status String @db.NVarChar(191) @default("OPEN")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  door WarehouseAccessDoor @relation(fields: [doorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([warehouseId, status, createdAt])
  @@map("warehouse_security_alerts")
}

model Category {
  id          String    @id @default(uuid()) @db.NVarChar(191)
  code        String @db.NVarChar(191)    @unique
  name        String @db.NVarChar(191)    @unique
  description String? @db.NVarChar(Max)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  lastReceivedAt DateTime?
  purchaseUnit String? @db.NVarChar(191)
  purchasePackSize Int @default(1)
  leadTimeDays Int?
  archivedAt DateTime?
  id         String   @id @default(uuid()) @db.NVarChar(191)
  code       String @db.NVarChar(191)   @unique
  name       String @db.NVarChar(191)
  unit       String @db.NVarChar(191)
  baseUnit   String? @db.NVarChar(191)
  unitsPerUnit Int    @default(1)
  active     Boolean  @default(true)
  categoryId String   @db.NVarChar(191)
  imageUrl      String? @db.NVarChar(Max)
  imagePublicId String? @db.NVarChar(Max)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skus       Sku[]

  @@index([categoryId, active])
  @@index([name])
  @@map("products")
}

model Customer {
  id        String   @id @default(uuid()) @db.NVarChar(191)
  code      String @db.NVarChar(191)   @unique
  name      String @db.NVarChar(191)
  phone     String @db.NVarChar(191)   @unique
  email     String? @db.NVarChar(191)
  address   String? @db.NVarChar(Max)
  note      String? @db.NVarChar(Max)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]
  receivables Receivable[]

  @@index([name])
  @@index([active, updatedAt])
  @@map("customers")
}

model Sku {
  id           String         @id @default(uuid()) @db.NVarChar(191)
  code         String @db.NVarChar(191)         @unique
  barcode      String @db.NVarChar(191)         @unique
  sellingPrice Decimal        @db.Decimal(14, 2)
  costPrice    Decimal        @db.Decimal(14, 2)
  active       Boolean        @default(true)
  productId    String         @db.NVarChar(191)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priceHistory PriceHistory[]
  invoiceItems InvoiceItem[]
  inventories Inventory[]
  inventoryTransactions InventoryTransaction[]
  stocktakeItems StocktakeItem[]
  transferItems StockTransferItem[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  iotTagMappings IotTagMapping[]
  iotMappedEvents IotEvent[] @relation("IotEventMappedSku")
  salesReturnItems SalesReturnItem[]
  supplierReturnItems SupplierReturnItem[]
  demandForecasts DemandForecast[]
  inventoryRecommendations InventoryRecommendation[]

  @@index([productId, active])
  @@map("skus")
}

model ForecastRun {
  id           String   @id @default(uuid()) @db.NVarChar(191)
  storeId      String   @db.NVarChar(191)
  horizonDays  Int
  historyDays  Int
  model        String @db.NVarChar(191)
  forecastFrom DateTime
  forecastTo   DateTime
  generatedAt  DateTime @default(now())
  store        Store    @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forecasts    DemandForecast[]
  recommendations InventoryRecommendation[]

  @@index([storeId, horizonDays, generatedAt])
  @@map("forecast_runs")
}

model DemandForecast {
  id                String   @id @default(uuid()) @db.NVarChar(191)
  runId             String   @db.NVarChar(191)
  skuId             String   @db.NVarChar(191)
  predictedQuantity Int
  observedQuantity  Int
  dataQuality       String @db.NVarChar(191)
  availableAtRun    Int
  safetyStockAtRun  Int
  safetyStockEvidence String? @db.NVarChar(Max)
  run               ForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sku               Sku         @relation(fields: [skuId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([runId, skuId])
  @@index([skuId])
  @@map("demand_forecasts")
}

model InventoryRecommendation {
  id                     String   @id @default(uuid()) @db.NVarChar(191)
  dedupeKey              String @db.NVarChar(191)   @unique
  forecastRunId          String   @db.NVarChar(191)
  targetStoreId          String   @db.NVarChar(191)
  skuId                  String   @db.NVarChar(191)
  type                   String @db.NVarChar(191)
  status                 String @db.NVarChar(191)   @default("PENDING")
  suggestedQuantity      Int
  finalQuantity          Int?
  sourceWarehouseId      String?  @db.NVarChar(191)
  destinationWarehouseId String?  @db.NVarChar(191)
  generatedById          String   @db.NVarChar(191)
  decidedById            String?  @db.NVarChar(191)
  decisionNote           String? @db.NVarChar(Max)
  decidedAt              DateTime?
  transferId             String?  @unique @db.NVarChar(191)
  purchaseRequestId      String?  @unique @db.NVarChar(191)
  createdAt              DateTime @default(now())
  forecastRun            ForecastRun @relation(fields: [forecastRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetStore            Store @relation(fields: [targetStoreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sku                    Sku @relation(fields: [skuId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceWarehouse        Warehouse? @relation("RecommendationSource", fields: [sourceWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destinationWarehouse   Warehouse? @relation("RecommendationDestination", fields: [destinationWarehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  generatedBy            User @relation("RecommendationGenerator", fields: [generatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedBy              User? @relation("RecommendationDecider", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transfer               StockTransfer? @relation(fields: [transferId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseRequest        PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([forecastRunId, createdAt])
  @@index([targetStoreId, status])
  @@map("inventory_recommendations")
}

model PriceHistory {
  id           String   @id @default(uuid()) @db.NVarChar(191)
  skuId        String   @db.NVarChar(191)
  sellingPrice Decimal  @db.Decimal(14, 2)
  costPrice    Decimal  @db.Decimal(14, 2)
  changedById  String?  @db.NVarChar(191)
  effectiveAt  DateTime @default(now())
  sku          Sku      @relation(fields: [skuId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changedBy    User?    @relation(fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([skuId, effectiveAt])
  @@map("price_history")
}

model WorkShift {
  id                String   @id @default(uuid()) @db.NVarChar(191)
  code              String @db.NVarChar(191)   @unique
  storeId           String   @db.NVarChar(191)
  cashierId         String   @db.NVarChar(191)
  posCode           String @db.NVarChar(191)
  name              String @db.NVarChar(191)
  status            String @db.NVarChar(191)   @default("OPEN")
  openingCash       Decimal  @db.Decimal(14, 2)
  cashRevenue       Decimal  @default(0) @db.Decimal(14, 2)
  digitalRevenue    Decimal  @default(0) @db.Decimal(14, 2)
  cashExpenses      Decimal  @default(0) @db.Decimal(14, 2)
  closingCash       Decimal? @db.Decimal(14, 2)
  cashDiscrepancy   Decimal? @db.Decimal(14, 2)
  discrepancyReason String? @db.NVarChar(Max)
  denominations     String? @db.NVarChar(Max)
  openedAt          DateTime @default(now())
  closedAt          DateTime?
  approvedAt        DateTime?
  approvedById      String?  @db.NVarChar(191)
  managerNote       String? @db.NVarChar(191)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  store             Store    @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashier           User     @relation("ShiftCashier", fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy        User?    @relation("ShiftApprover", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices           Invoice[]
  payosCheckouts     PayosCheckout[]

  @@index([storeId, openedAt])
  @@index([cashierId, openedAt])
  @@index([status, openedAt])
  @@map("work_shifts")
}

model Invoice {
  id                 String           @id @default(uuid()) @db.NVarChar(191)
  code               String @db.NVarChar(191)           @unique
  shiftId            String           @db.NVarChar(191)
  warehouseId        String?          @db.NVarChar(191)
  storeId            String           @db.NVarChar(191)
    cashierId          String           @db.NVarChar(191)
    customerId         String?          @db.NVarChar(191)
  customerName       String? @db.NVarChar(191)
  customerPhone      String? @db.NVarChar(191)
  status             String @db.NVarChar(191)           @default("COMPLETED")
  subtotal           Decimal          @db.Decimal(14, 2)
  discount           Decimal          @default(0) @db.Decimal(14, 2)
  total              Decimal          @db.Decimal(14, 2)
  refundedAmount     Decimal          @default(0) @db.Decimal(14, 2)
  creditAmount       Decimal          @default(0) @db.Decimal(14, 2)
  note               String? @db.NVarChar(Max)
  completedAt        DateTime         @default(now())
  cancelledAt        DateTime?
  cancelledById      String?          @db.NVarChar(191)
  cancellationReason String? @db.NVarChar(Max)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  shift              WorkShift        @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse          Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  store              Store            @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    cashier            User             @relation("InvoiceCashier", fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    customer           Customer?        @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cancelledBy        User?            @relation("InvoiceCanceller", fields: [cancelledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items              InvoiceItem[]
  payments           InvoicePayment[]
  salesReturns       SalesReturn[]
  receivable         Receivable?
  payosCheckout      PayosCheckout?

  @@index([storeId, completedAt])
  @@index([shiftId, completedAt])
  @@index([warehouseId, completedAt])
    @@index([cashierId, completedAt])
    @@index([customerId, completedAt])
  @@index([status, completedAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.NVarChar(191)
  invoiceId   String   @db.NVarChar(191)
  skuId       String   @db.NVarChar(191)
  productCode String @db.NVarChar(191)
