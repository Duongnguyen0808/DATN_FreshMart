  approvedBy             User?     @relation("TransferApprover", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dispatchedBy           User?     @relation("TransferDispatcher", fields: [dispatchedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy             User?     @relation("TransferReceiver", fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cancelledBy            User?     @relation("TransferCanceller", fields: [cancelledById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discrepancyResolvedBy  User?     @relation("TransferDiscrepancyResolver", fields: [discrepancyResolvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
