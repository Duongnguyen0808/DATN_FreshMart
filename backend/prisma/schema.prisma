model LotMovement {
  id String @id @default(uuid()) @db.NVarChar(191)
  lotId String @db.NVarChar(191)
  quantity Int
  referenceType String @db.NVarChar(191)
  referenceId String @db.NVarChar(191)
  actorId String @db.NVarChar(191)
  createdAt DateTime @default(now())
  lot InventoryLot @relation(fields: [lotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([referenceType, referenceId])
  @@map("lot_movements")
}

model LotDisposal {
  id String @id @default(uuid()) @db.NVarChar(191)
  lotId String @db.NVarChar(191)
  quantity Int
  reason String @db.NVarChar(Max)
  status String @db.NVarChar(191) @default("READY")
  createdById String @db.NVarChar(191)
  approvedById String? @db.NVarChar(191)
  completedById String? @db.NVarChar(191)
  evidence String? @db.NVarChar(Max)
  createdAt DateTime @default(now())
  completedAt DateTime?
  lot InventoryLot @relation(fields: [lotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("lot_disposals")
}

model IotInboundParcel {
  id String @id @default(uuid()) @db.NVarChar(191)
